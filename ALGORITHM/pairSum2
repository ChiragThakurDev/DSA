#include <iostream>
#include <vector>
using namespace std;

vector<int> pairSum(vector<int>& arr, int target) {
    vector<int> ans;

    int n = arr.size();

    int i = 0;        // Left pointer
    int j = n - 1;    // Right pointer

    while (i < j) {

        int pS = arr[i] + arr[j];

        if (pS < target) {
            i++;
        }
        else if (pS > target) {
            j--;
        }
        else {
            // Pair found
            ans.push_back(i);
            ans.push_back(j);

            return ans;
        }
    }

    // No pair found
    return {};
}

int main() {

    vector<int> arr = {2, 3, 5, 6, 7, 8};
    int target = 11;

    vector<int> ans = pairSum(arr, target);

    if (!ans.empty()) {
        cout << "Results: " << ans[0] << " " << ans[1] << endl;
    }
    else {
        cout << "No pair found" << endl;
    }

    return 0;
}


//pair Sum approach using 2 pointer approach.
